rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwnDoc() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ==============================
    // USERS & DEVICES
    // ==============================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==============================
    // SUBJECTS
    // ==============================
    match /subjects/{subjectId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update: if isDocOwner() && isCreatingOwnDoc();
    }

    // ==============================
    // ATTENDANCE
    // ==============================
    match /attendance/{attendanceId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update: if isDocOwner() && isCreatingOwnDoc();
    }

    // ==============================
    // ASSIGNMENTS
    // ==============================
    match /assignments/{assignmentId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update: if isDocOwner() && isCreatingOwnDoc();
    }

    // ==============================
    // STUDY SESSIONS
    // ==============================
    match /studySessions/{sessionId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update: if isDocOwner() && isCreatingOwnDoc();
    }

    // ==============================
    // STUDY GOALS
    // ==============================
    match /studyGoals/{goalId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update: if isDocOwner() && isCreatingOwnDoc();
    }

    // ==============================
    // NOTIFICATIONS
    // ==============================
    match /notifications/{notificationId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update: if isDocOwner() && isCreatingOwnDoc();
    }
  }
}